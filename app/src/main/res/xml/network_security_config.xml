<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext and no user CAs. Host trust is the certificate pin, checked in :core. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
