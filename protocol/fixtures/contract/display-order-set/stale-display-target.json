{
  "case": "display-order-set/stale-display-target",
  "description": "A submitted key refers to a disconnected connector.",
  "request": {
    "method": "POST",
    "path": "/v1/display/order",
    "headers": {
      "Authorization": "Bearer fixture-token-0002-xxxxxxxxxxxxxxxxxxxxxxxx"
    },
    "body": {
      "request_id": "order-1",
      "output_keys": [
        "drm:card0:HDMI-A-2",
        "drm:card0:DP-1"
      ],
      "generation": 1,
      "restart": false
    }
  },
  "response": {
    "status": 409,
    "body": {
      "error": "stale_display_target",
      "message": "a selected screen is no longer connected"
    }
  }
}
