{
  "case": "pair-request/advanced-client-conflict",
  "description": "A request that presents the valid pairing_session but a different client_id than the one that claimed the pairing.",
  "request": {
    "method": "POST",
    "path": "/v1/pair/request",
    "headers": {},
    "body": {
      "pairing_id": "pair-fixture0001xxxxxxxxxxxxx",
      "secret": "fixture-token-0001-xxxxxxxxxxxxxxxxxxxxxxxx",
      "client_name": "Android Companion",
      "client_id": "client-android-tablet",
      "scopes": [
        "status.read",
        "power.control",
        "display.control"
      ],
      "pairing_session": "fixture-token-0002-xxxxxxxxxxxxxxxxxxxxxxxx"
    }
  },
  "response": {
    "status": 409,
    "body": {
      "error": "pairing_client_conflict",
      "message": "pairing is already claimed by another client"
    }
  }
}
